{:paths ["src"]
 :deps
 {io.github.casselc/samizdat
  {:git/url "https://github.com/casselc/samizdat.git"
   :git/sha "ff9cfd8cf6bf08c0f61b71cc98eee8c354efa861"}
  ;; Jolt 0.8.1+ resolves library-owned host classes through :jolt/provides.
  ;; Samizdat's pinned revision predates time v0.0.8, whose declaration makes
  ;; Malli's simple DateTimeFormatterBuilder constructor resolvable.
  io.github.jolt-lang/time
  {:git/url "https://github.com/jolt-lang/time.git"
   :git/sha "33c5e9831c046cfcbe68bc0c9c33e92568eaebb1"}

  ;; Samizdat also predates jolt-crypto v0.0.5, which declares the JDK crypto
  ;; classes installed by its RFC 0014 implementation.
  io.github.jolt-lang/jolt-crypto
  {:git/url "https://github.com/jolt-lang/jolt-crypto.git"
   :git/sha "44da69bad08a2fd7631bd4061e3fb53938dafff6"}
  io.github.chucklehead-dev/jolt-aspect-packs
  {:local/root "../.."}}
 :jolt/build
 {:aspects
  [{:resource "META-INF/jolt/aspects/packs/mycelium-dd13b4b.edn"
    :provider jolt.aspect-packs.mycelium.provider/aspect-provider}]
  :aspect-report "target/aspects.edn"}}
